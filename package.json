{
  "name": "school-financial-entry-system",
  "version": "1.0.0",
  "description": "School Financial Entry System - desktop app",
  "main": "main.js",
  "author": "School Financial Entry System",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.schoolfinancialentry.app",
    "productName": "School Financial Entry System",
    "files": [
      "main.js",
      "app.html",
      "assets/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "School Financial Entry System"
    }
  }
}
